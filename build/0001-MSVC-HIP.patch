From 56933471af36147e1032fbbc7912ca0088797b78 Mon Sep 17 00:00:00 2001
From: Aaryaman Vasishta <aaryaman.vasishta@amd.com>
Date: Sun, 10 Dec 2023 18:40:22 +0900
Subject: [PATCH] Fix BitScanreverse by including intrin.h for MSVC

Also pass an unsigned long index to the _BitScan* intrinsics; newer clang
(HIP SDK 7.x) rejects uint32_t*/uint64_t* there (-Wincompatible-pointer-types).
---
 common/compiler_msc.h | 25 +++++++++++++++++--------
 1 file changed, 17 insertions(+), 8 deletions(-)

diff --git a/common/compiler_msc.h b/common/compiler_msc.h
index 18cfa12..7397846 100644
--- a/common/compiler_msc.h
+++ b/common/compiler_msc.h
@@ -4,6 +4,7 @@
 
 #include <stdint.h>
 #include <stdlib.h> /* for _byteswap_*() */
+#include <intrin.h>
 
 #define LIBEXPORT	__declspec(dllexport)
 
@@ -46,16 +47,20 @@ typedef int ssize_t;
 static forceinline unsigned
 bsr32(uint32_t n)
 {
-	_BitScanReverse(&n, n);
-	return n;
+	unsigned long i;
+
+	_BitScanReverse(&i, n);
+	return i;
 }
 #define bsr32 bsr32
 
 static forceinline unsigned
 bsf32(uint32_t n)
 {
-	_BitScanForward(&n, n);
-	return n;
+	unsigned long i;
+
+	_BitScanForward(&i, n);
+	return i;
 }
 #define bsf32 bsf32
 
@@ -64,16 +69,20 @@ bsf32(uint32_t n)
 static forceinline unsigned
 bsr64(uint64_t n)
 {
-	_BitScanReverse64(&n, n);
-	return n;
+	unsigned long i;
+
+	_BitScanReverse64(&i, n);
+	return i;
 }
 #define bsr64 bsr64
 
 static forceinline unsigned
 bsf64(uint64_t n)
 {
-	_BitScanForward64(&n, n);
-	return n;
+	unsigned long i;
+
+	_BitScanForward64(&i, n);
+	return i;
 }
 #define bsf64 bsf64
 
-- 
2.33.0.windows.2

