#!/bin/sh
# Generated by CMake from scripts/hiprt.sh.in: builds hiprt.hipfb next to pbrt
set -e
cd "@PROJECT_BINARY_DIR@"

# "@hip_HIPCC_EXECUTABLE@" -I. -I"@PROJECT_SOURCE_DIR@/src" -I"@PROJECT_SOURCE_DIR@/src/ext/hiprt/" -I"@PROJECT_SOURCE_DIR@/src/ext/openvdb/nanovdb" -x hip "@PROJECT_SOURCE_DIR@/src/pbrt/gpu/hiprt/hiprt.cu" -O3 -ffast-math -std=c++17 --cuda-device-only --genco @PBRT_HIPRT_OFFLOAD_ARCHS@ -DWARP_THREADS=32 -D__HIP_PLATFORM_AMD__ -DHIPCC_OS_LINUX -DPBRT_BUILD_GPU_RENDERER -DPBRT_RESTRICT=__restrict__ -DPBRT_IS_LINUX -DBLOCK_SIZE=64 -DSHARED_STACK_SIZE=16 -o hiprt.hipfb

"@hip_HIPCC_EXECUTABLE@" -I. -I"@PROJECT_SOURCE_DIR@/src" -I"@PROJECT_SOURCE_DIR@/src/ext/hiprt/" -I"@PROJECT_SOURCE_DIR@/src/ext/openvdb/nanovdb" -x hip "@PROJECT_SOURCE_DIR@/src/pbrt/gpu/hiprt/hiprt.cu" "@PROJECT_SOURCE_DIR@/src/pbrt/util/sobolmatrices.cpp" "@PROJECT_SOURCE_DIR@/src/pbrt/util/primes.cpp" "@PROJECT_SOURCE_DIR@/src/pbrt/options.cpp" "@PROJECT_SOURCE_DIR@/src/pbrt/shapes.cpp" -O3 -ffast-math -std=c++17 @PBRT_HIPRT_OFFLOAD_ARCHS@ -fgpu-rdc -c -emit-llvm -DWARP_THREADS=32 -D__HIP_PLATFORM_AMD__ -DHIPCC_OS_LINUX -DPBRT_BUILD_GPU_RENDERER -DPBRT_RESTRICT=__restrict__ -DPBRT_IS_LINUX -DBLOCK_SIZE=64 -DSHARED_STACK_SIZE=16

"@CMAKE_CXX_COMPILER@" -O3 -mllvm -amdgpu-long-branch-factor=0 -fgpu-rdc --hip-link -Xoffload-linker --whole-archive --cuda-device-only @PBRT_HIPRT_OFFLOAD_ARCHS@ hiprt_amd_lib.bc hiprt.bc primes.bc sobolmatrices.bc options.bc shapes.bc -o hiprt.hipfb
